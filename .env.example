# Enquiry form delivery (server only — never prefix these with NEXT_PUBLIC_).
# Without RESEND_API_KEY the form falls back to opening the visitor's email app.
RESEND_API_KEY=
# Where enquiries are delivered.
ENQUIRY_TO=teaminizio.media@gmail.com
# A sender on a domain verified in Resend, e.g. "Inizio Media <hello@your-domain.com>".
ENQUIRY_FROM=

# Public site origin for canonical URLs and the sitemap, e.g. https://iniziomedia.in
# (on Vercel the production domain is used when this is empty).
NEXT_PUBLIC_SITE_URL=

# The beginnings wall (Clientele page) stores notes in Upstash Redis. Connecting Upstash to the
# project in Vercel (Storage → Upstash for Redis) sets KV_REST_API_URL and KV_REST_API_TOKEN;
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN from Upstash's own console work too.
# Without them, local development keeps notes in memory and production shows an empty wall.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password for /admin/notes, where notes are approved or deleted (at least 12 characters).
# New-note alerts are emailed to ENQUIRY_TO using the Resend settings above.
ADMIN_PASSWORD=
