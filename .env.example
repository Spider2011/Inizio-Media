# Enquiry form delivery (server only — never prefix these with NEXT_PUBLIC_).
# Without RESEND_API_KEY the form falls back to opening the visitor's email app.
RESEND_API_KEY=
# Where enquiries are delivered.
ENQUIRY_TO=teaminizio.media@gmail.com
# A sender on a domain verified in Resend, e.g. "Inizio Media <hello@your-domain.com>".
ENQUIRY_FROM=
