{
  "name": "inizio-media-site",
  "version": "2.0.0",
  "private": true,
  "description": "Inizio Media homepage: Next.js + Motion, built from the Inizio Media design system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
